{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"packages/*/src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p packages/agentic-themes/tsconfig.lib.json --noEmit && tsc -p packages/agentic/tsconfig.lib.json --noEmit && tsc -p packages/docs/tsconfig.app.json --noEmit",
    "test": "pnpm test:themes && pnpm test:agentic",
    "test:themes": "vitest run --config packages/agentic-themes/vitest.config.mts",
    "test:agentic": "vitest run --config packages/agentic/vitest.config.mts",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "build": "nx run-many -t build --projects=agentic,agentic-themes && pnpm build:schematics",
    "build:schematics": "tsc -p packages/agentic/tsconfig.schematics.json && cp packages/agentic/schematics/package.json dist/packages/agentic/schematics/package.json && cp packages/agentic/schematics/collection.json dist/packages/agentic/schematics/collection.json && cp packages/agentic/schematics/ng-add/schema.json dist/packages/agentic/schematics/ng-add/schema.json && node scripts/finalize-agentic-pkg.mjs",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "private": true,
  "lint-staged": {
    "packages/*/src/**/*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,js,mjs,cjs,json,md,css,scss,html,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "@analogjs/router": "^2.6.3",
    "@angular-devkit/build-angular": "21.2.7",
    "@angular/common": "21.2.9",
    "@angular/compiler": "21.2.9",
    "@angular/core": "21.2.9",
    "@angular/forms": "21.2.9",
    "@angular/platform-browser": "21.2.9",
    "@angular/platform-server": "~21.2.9",
    "@angular/router": "21.2.9",
    "@angular/ssr": "21.2.7",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.6",
    "marked-highlight": "^2.2.4",
    "rxjs": "~7.8.0",
    "zone.js": "0.16.0"
  },
  "devDependencies": {
    "@analogjs/platform": "2.6.3",
    "@analogjs/vite-plugin-angular": "2.6.3",
    "@analogjs/vitest-angular": "2.6.3",
    "@angular-devkit/core": "21.2.7",
    "@angular-devkit/schematics": "21.2.7",
    "@angular/build": "21.2.7",
    "@angular/cli": "21.2.7",
    "@angular/compiler-cli": "21.2.9",
    "@angular/language-service": "21.2.9",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^9.8.0",
    "@nx/angular": "23.0.1",
    "@nx/devkit": "23.0.1",
    "@nx/esbuild": "23.0.1",
    "@nx/eslint": "23.0.1",
    "@nx/eslint-plugin": "23.0.1",
    "@nx/js": "23.0.1",
    "@nx/storybook": "23.0.1",
    "@nx/vite": "23.0.1",
    "@nx/vitest": "23.0.1",
    "@nx/web": "23.0.1",
    "@nx/workspace": "23.0.1",
    "@oxc-project/runtime": "^0.115.0",
    "@schematics/angular": "21.2.7",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/angular": "^10.1.0",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "20.19.9",
    "@typescript-eslint/utils": "^8.40.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "angular-eslint": "21.3.1",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.27.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "front-matter": "^4.0.2",
    "husky": "^9.1.7",
    "jiti": "2.4.2",
    "jsdom": "~22.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "lint-staged": "^17.0.8",
    "ng-packagr": "~21.2.0",
    "nx": "23.0.1",
    "postcss": "^8.4.5",
    "prettier": "^3.8.1",
    "storybook": "^10.1.0",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "verdaccio": "^6.3.2",
    "vite": "8.0.9",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "~4.1.0"
  },
  "nx": {
    "includedScripts": []
  }
}
